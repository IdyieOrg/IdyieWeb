<%#= select_tag "search[select]", options_for_select(
  [
    "Fais-moi un bilan comptable sous forme de barre pour le groupe X",
    "Fais en sorte que le débit soit en rouge et le crédit en vert",
    "Fais-moi un tableau que je pourrais exporter sous différents formats"
  ]
), { class: "select2", style: "width: 100%;" } %>

<div class="prompt-page">
  <div id="sidebar" class="sidebar">
    <button id="closeSidebar" style="position:absolute;top:18px;right:18px;background:none;border:none;color:#fff;font-size:1.5rem;cursor:pointer;z-index:101;">
      <i class="fas fa-xmark"></i>
    </button>
    <h2 class="sidebar-title fondamento-regular">Idyie</h2>
    <hr>
    <ul class="sidebar-menu">
      <li><%= link_to raw('<i class="fas fa-plus"></i> Nouvelle Requête'), '#', class: '' %></li>
      <li><%= link_to raw('<i class="fas fa-history"></i> Historique'), '#', class: '' %></li>
      <li><%= link_to raw('<i class="fas fa-cog"></i> Paramètres'), '#', id: 'openSettingsModal' %></li>
    </ul>
    <hr class="sidebar-bottom-hr">
    <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'btn btn-danger w-100' %>
  </div>

  <button id="toggleSidebar" class="menu-btn">
    <i class="icon-menu fas fa-bars"></i>
  </button>

  <div class="main-content">
    <div class="chat-area">
      <div id="chat-box" class="chat-box"></div>
    </div>

    <form class="prompt-input-bar" autocomplete="off" onsubmit="return false;">
      <button type="button" class="mic-btn" tabindex="-1">
        <i class="fas fa-microphone" id="microphone"></i>
      </button>
      <input type="text" name="search[query]" class="prompt-input" placeholder="Tapez votre requête ici" autocomplete="off" />
      <button type="submit" id="prompt" class="send-btn">Envoyer</button>
    </form>
  </div>
</div>

<div id="settingsModal" class="modal fade" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content settings-modal-content">
      <div class="modal-header settings-modal-header">
        <h5 class="modal-title" id="settingsModalLabel">Paramètres</h5>
        <%= button_tag "", type: "button", class: "btn-close", data: { bs_dismiss: "modal" }, aria: { label: "Close" } %>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-4 settings-menu-col">
            <ul class="nav flex-column nav-pills settings-menu" id="settingsMenu" role="tablist">
              <li class="nav-item" role="presentation">
                <%= link_to 'Profil', '#profile-settings', class: 'nav-link active', id: 'profile-tab', data: { bs_toggle: 'pill' }, role: 'tab', aria_controls: 'profile-settings', aria_selected: 'true' %>
              </li>
              <li class="nav-item" role="presentation">
                <%= link_to 'Général', '#general-settings', class: 'nav-link', id: 'general-tab', data: { bs_toggle: 'pill' }, role: 'tab', aria_controls: 'general-settings', aria_selected: 'false' %>
              </li>
              <li class="nav-item" role="presentation">
                <%= link_to 'Personnalisation', '#customization-settings', class: 'nav-link', id: 'customization-tab', data: { bs_toggle: 'pill' }, role: 'tab', aria_controls: 'customization-settings', aria_selected: 'false' %>
              </li>
            </ul>

          </div>

          <div class="col-md-8">
            <div class="tab-content">
              <div class="tab-pane fade show active" id="profile-settings" role="tabpanel" aria-labelledby="profile-tab">
                <h5>Profil</h5>

                <div class="d-flex align-items-center mb-3">
                  <%= image_tag "/logo_idyie.png", id: "profileImage", class: "rounded-circle profile-img", width: 100, height: 100 %>

                  <div class="ms-3">
                    <%= label_tag :profile_pic, "Changer", class: "btn btn-outline-light btn-sm", for: "profilePicUpload" %>
                    <%= file_field_tag :profile_pic, id: "profilePicUpload", accept: "image/*", class: "d-none" %>
                  </div>
                </div>

                <div class="mb-3">
                  <%= label_tag :username, "Nom d'utilisateur", class: "form-label" %>
                  <%= text_field_tag :username, "MonPseudo", class: "form-control profile-input" %>
                </div>

                <div class="mb-3">
                  <%= label_tag :email, "Email", class: "form-label" %>
                  <%= email_field_tag :email, "exemple@email.com", class: "form-control profile-input" %>
                </div>
              </div>

              <div class="tab-pane fade" id="general-settings" role="tabpanel" aria-labelledby="general-tab">
                <h5>Général</h5>

                <div class="mb-3">
                  <%= label_tag :theme, "Thème", class: "form-label" %>
                  <%= select_tag :theme, options_for_select([["Système", "system"], ["Clair", "light"], ["Sombre", "dark"]]), class: "form-select theme-select" %>
                </div>

                <div class="mb-3">
                  <%= label_tag :language, "Langue", class: "form-label" %>
                  <%= select_tag :language, options_for_select([["Français", "fr"], ["English", "en"]]), class: "form-select language-select" %>
                </div>

                <div class="mt-4">
                  <%= button_tag "Supprimer tous les chats", type: "button", class: "btn btn-danger", id: "deleteAllChats" %>
                </div>
              </div>


              <div class="tab-pane fade" id="customization-settings" role="tabpanel" aria-labelledby="customization-tab">
                <h5>Personnalisation</h5>

                <div class="mb-3">
                  <%= label_tag :color_palette, "Palette de couleurs", class: "form-label" %>
                  <%= select_tag :color_palette, options_for_select([
                    ["Défaut", "default"],
                    ["Daltonisme - Protanopie", "protanopia"],
                    ["Daltonisme - Deutéranopie", "deuteranopia"],
                    ["Daltonisme - Tritanopie", "tritanopia"],
                    ["Contraste élevé", "high_contrast"]
                  ]), class: "form-select palette-select" %>
                </div>

                <div class="mb-3">
                  <%= label_tag :text_size, "Taille du texte", class: "form-label" %>
                  <%= range_field_tag :text_size, 16, min: 12, max: 24, step: 1, class: "form-range", id: "textSizeRange" %>
                </div>

                <div class="mb-3 p-3 border rounded text-size-preview" id="textSizePreview">
                  Aperçu du texte (taille dynamique)
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer settings-modal-footer">
        <%= button_tag "Enregistrer", type: "button", class: "btn btn-success" %>
      </div>
    </div>
  </div>
</div>


<div id="result"></div>

<script>
  console.log('Prompt: Script loaded');

  // Check if DOM is already loaded
  if (document.readyState === 'loading') {
    console.log('Prompt: DOM still loading, waiting for DOMContentLoaded');
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Prompt: DOM Content Loaded - Initializing prompt page');
      initPromptPage();
    });
  } else {
    console.log('Prompt: DOM already loaded, initializing immediately');
    initPromptPage();
  }

  function initPromptPage() {
    console.log('Prompt: Initializing prompt page functionality');

    // Initialiser le thème en premier
    const savedTheme = localStorage.getItem('idyie_theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    console.log('Prompt: Theme set to:', savedTheme);

    // Gestion de la sidebar
    var sidebar = document.getElementById('sidebar');
    var toggleBtn = document.getElementById('toggleSidebar');
    var promptPage = document.querySelector('.prompt-page');

    console.log('Prompt: Sidebar elements found:', {
      sidebar: !!sidebar,
      toggleBtn: !!toggleBtn,
      promptPage: !!promptPage
    });

    if (toggleBtn && sidebar && promptPage) {
      var icon = toggleBtn.querySelector('i');
      console.log('Prompt: Icon element found:', !!icon);

      // Récupérer l'état sauvegardé de la sidebar ou ouvrir par défaut
      const savedSidebarState = localStorage.getItem('sidebar_open');
      const shouldOpenSidebar = savedSidebarState === null ? true : savedSidebarState === 'true';

      console.log('Prompt: Saved sidebar state:', savedSidebarState, 'Should open:', shouldOpenSidebar);

      if (shouldOpenSidebar) {
        sidebar.classList.add('open');
        promptPage.classList.add('sidebar-open');
        icon.classList.remove('fa-bars');
        icon.classList.add('fa-xmark');
        console.log('Prompt: Sidebar opened by default or saved state');
        console.log('Prompt: Icon should be X, current classes:', icon.className);
      } else {
        sidebar.classList.remove('open');
        promptPage.classList.remove('sidebar-open');
        icon.classList.remove('fa-xmark');
        icon.classList.add('fa-bars');
        console.log('Prompt: Sidebar closed by saved state');
        console.log('Prompt: Icon should be burger, current classes:', icon.className);
      }

      // Remove any existing listeners to avoid duplicates
      toggleBtn.removeEventListener('click', toggleSidebarHandler);
      toggleBtn.addEventListener('click', toggleSidebarHandler);

      function toggleSidebarHandler(e) {
        e.stopPropagation();
        console.log('Prompt: Toggle sidebar clicked');
        const isOpen = sidebar.classList.toggle('open');
        promptPage.classList.toggle('sidebar-open', isOpen);
        console.log('Prompt: Sidebar is now:', isOpen ? 'open' : 'closed');

        // Sauvegarder l'état de la sidebar
        localStorage.setItem('sidebar_open', isOpen.toString());
        console.log('Prompt: Sidebar state saved:', isOpen);

        if (isOpen) {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-xmark');
          console.log('Prompt: Icon changed to X');
        } else {
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars');
          console.log('Prompt: Icon changed to burger');
        }
      }

      console.log('Prompt: Sidebar toggle handler attached');
    } else {
      console.error('Prompt: Missing sidebar elements:', {
        sidebar: !!sidebar,
        toggleBtn: !!toggleBtn,
        promptPage: !!promptPage
      });
    }

    // Gestion du bouton de fermeture de la sidebar
    const closeSidebarBtn = document.getElementById('closeSidebar');
    if (closeSidebarBtn) {
      closeSidebarBtn.onclick = function() {
        console.log('Prompt: Close sidebar clicked');
        if (sidebar) sidebar.classList.remove('open');
        if (promptPage) promptPage.classList.remove('sidebar-open');
        // Remettre l'icône burger si besoin
        if (toggleBtn) {
          var icon = toggleBtn.querySelector('i');
          if (icon) {
            icon.classList.remove('fa-xmark');
            icon.classList.add('fa-bars');
            console.log('Prompt: Icon changed to burger after close');
          }
        }
        // Sauvegarder l'état fermé
        localStorage.setItem('sidebar_open', 'false');
        console.log('Prompt: Sidebar state saved as closed');
      };
      console.log('Prompt: Close sidebar handler attached');
    }

    // Gestion du bouton d'ouverture de la modal
    var openSettingsBtn = document.getElementById('openSettingsModal');
    if (openSettingsBtn) {
      openSettingsBtn.addEventListener('click', function() {
        var myModalEl = document.getElementById('settingsModal');
        var myModal = new bootstrap.Modal(myModalEl);
        myModal.show();
        localStorage.setItem('settings_modal_open', 'true');
        var promptPage = document.querySelector('.prompt-page');
        if (promptPage) promptPage.classList.add('modal-opened');
        myModalEl.addEventListener('hidden.bs.modal', function() {
          if (promptPage) promptPage.classList.remove('modal-opened');
          localStorage.setItem('settings_modal_open', 'false');
        }, { once: true });
      });
    }

    // Persistance de l'onglet actif du modal
    document.querySelectorAll('#settingsMenu .nav-link').forEach(function(tab) {
      tab.addEventListener('shown.bs.tab', function(e) {
        localStorage.setItem('settings_modal_active_tab', e.target.id);
      });
    });

    // --- Ajout : Réouverture automatique du modal si besoin ---
    var myModalEl = document.getElementById('settingsModal');
    if (myModalEl && localStorage.getItem('settings_modal_open') === 'true') {
      var myModal = new bootstrap.Modal(myModalEl);
      myModal.show();
      var promptPage = document.querySelector('.prompt-page');
      if (promptPage) promptPage.classList.add('modal-opened');
      myModalEl.addEventListener('hidden.bs.modal', function() {
        if (promptPage) promptPage.classList.remove('modal-opened');
        localStorage.setItem('settings_modal_open', 'false');
      }, { once: true });
      // Restaure l'onglet actif du modal si besoin
      var lastActiveTabId = localStorage.getItem('settings_modal_active_tab');
      if (lastActiveTabId) {
        var lastActiveTab = document.getElementById(lastActiveTabId);
        if (lastActiveTab) {
          var tab = new bootstrap.Tab(lastActiveTab);
          tab.show();
        }
      }
    }

    // Initialisation de la reconnaissance vocale
    if ('webkitSpeechRecognition' in window) {
      const recognition = new webkitSpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = 'fr-FR';

      const microphone = document.getElementById('microphone');
      if (microphone) {
        microphone.style.color = "white";

        recognition.onstart = function() {
            console.log('Prompt: Reconnaissance vocale démarrée');
            microphone.style.color = "#7FFFAB";
        };

        recognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript;
            const input = document.querySelector("input[name='search[query]']");
            if (input) input.value = transcript;
            console.log('Prompt: Transcription : ', transcript);
        };

        recognition.onerror = function(event) {
            console.error('Prompt: Erreur de reconnaissance vocale : ', event.error);
            microphone.style.color = "red";
        };

        recognition.onend = function() {
            console.log('Prompt: Reconnaissance vocale terminée');
            microphone.style.color = "white";
        };

        microphone.addEventListener('click', function() {
            recognition.start();
        });
      }
    } else {
        console.error("Prompt: L'API Web Speech n'est pas supportée par ce navigateur.");
        alert("L'API Web Speech n'est pas supportée par ce navigateur.");
    }

    // Gestion du formulaire avec AJAX pour la réponse bot
    const promptForm = document.querySelector('.prompt-input-bar');
    if (promptForm) {
      promptForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const input = promptForm.querySelector('.prompt-input');
        const value = input.value.trim();
        if (value) {
          addMessageToChatBox(value, 'user');
          input.value = '';
          // Appel AJAX pour la réponse bot
          fetch('<%= url_for(controller: 'prompts', action: 'send_to_api') %>', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            },
            body: 'query=' + encodeURIComponent(value)
          })
          .then(response => response.json())
          .then(response => {
            // Traitement de la réponse
            try {
              const data = JSON.parse(response.data);
              if (Array.isArray(data)) {
                addMessageToChatBox("Aucun résultat", "bot");
              } else if (data.data_type === "barChart") {
                // Créer un canvas pour le graphique
                const canvasId = 'chart-' + Date.now();
                const canvasHtml = `<canvas id="${canvasId}" width="400" height="200"></canvas>`;
                addMessageToChatBox(canvasHtml, "bot", true);
                setTimeout(() => {
                  const ctx = document.getElementById(canvasId).getContext('2d');
                  new Chart(ctx, data.content);
                }, 100);
              } else if (data.data_type === "table") {
                let tableHtml = '<table class="table table-striped">';
                tableHtml += '<thead><tr>';
                data.content.columns.forEach(column => {
                  tableHtml += `<th>${column}</th>`;
                });
                tableHtml += '</tr></thead><tbody>';
                data.content.rows.forEach(row => {
                  tableHtml += '<tr>';
                  row.forEach(cell => {
                    tableHtml += `<td>${cell}</td>`;
                  });
                  tableHtml += '</tr>';
                });
                tableHtml += '</tbody></table>';
                addMessageToChatBox(tableHtml, "bot", true);
              } else {
                addMessageToChatBox("Réponse inconnue", "bot");
              }
            } catch (e) {
              addMessageToChatBox("Erreur de traitement de la réponse", "bot");
            }
          })
          .catch(() => {
            addMessageToChatBox("Une erreur est survenue", "bot");
          });
        }
      });
    }

    // DEBUG: observer pour détecter la fermeture de la sidebar
    if (sidebar) {
      const observer = new MutationObserver((mutations) => {
        if (!sidebar.classList.contains('open')) {
          console.log('Prompt: Sidebar closed');
        }
      });
      observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
    }

    console.log('Prompt: Prompt page initialization complete');
  }

  function addMessageToChatBox(content, sender, isHtml = false) {
    const chatBox = document.getElementById("chat-box");
    const messageContainer = document.createElement("div");
    messageContainer.style.display = "flex";
    messageContainer.style.margin = "10px 0";
    messageContainer.style.alignItems = "flex-end";
    messageContainer.style.position = "relative";

    const messageElement = document.createElement("div");
    messageElement.classList.add("message");
    messageElement.style.padding = "10px";
    messageElement.style.borderRadius = "5px";
    messageElement.style.maxWidth = "70%";
    messageElement.style.position = "relative";

    if (sender === "bot") {
      messageContainer.style.justifyContent = "flex-start";
      messageElement.style.backgroundColor = "#e9ecef";
      messageElement.style.color = "black";

      const botLogo = document.createElement("img");
      botLogo.src = "logo_idyie.png";
      botLogo.alt = "Bot Logo";
      botLogo.style.width = "30px";
      botLogo.style.height = "30px";
      botLogo.style.borderRadius = "50%";
      botLogo.style.margin = "0 10px";
      messageContainer.appendChild(botLogo);
      messageContainer.appendChild(messageElement);
    } else {
      messageContainer.style.justifyContent = "flex-end";
      messageElement.style.backgroundColor = "#7FFFAB";
      messageElement.style.color = "#111";
      messageContainer.appendChild(messageElement);
    }

    if (isHtml) {
      messageElement.innerHTML = content;
    } else {
      messageElement.textContent = content;
    }

    chatBox.appendChild(messageContainer);
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  function treatResponse(response) {
    try {
      const data = JSON.parse(response.data);
      if (Array.isArray(data)) {
        addMessageToChatBox("Aucun résultat", "bot");
      } else if (data.data_type === "barChart") {
        // Créer un canvas pour le graphique
        const canvasId = 'chart-' + Date.now();
        const canvasHtml = `<canvas id="${canvasId}" width="400" height="200"></canvas>`;
        addMessageToChatBox(canvasHtml, "bot", true);

        // Initialiser le graphique après un court délai
        setTimeout(() => {
          const ctx = document.getElementById(canvasId).getContext('2d');
          new Chart(ctx, data.content);
        }, 100);
      } else if (data.data_type === "table") {
        // Créer un tableau HTML
        let tableHtml = '<table class="table table-striped">';
        tableHtml += '<thead><tr>';
        data.content.columns.forEach(column => {
          tableHtml += `<th>${column}</th>`;
        });
        tableHtml += '</tr></thead><tbody>';
        data.content.rows.forEach(row => {
          tableHtml += '<tr>';
          row.forEach(cell => {
            tableHtml += `<td>${cell}</td>`;
          });
          tableHtml += '</tr>';
        });
        tableHtml += '</tbody></table>';
        addMessageToChatBox(tableHtml, "bot", true);
      } else {
        addMessageToChatBox("Réponse inconnue", "bot");
      }
    } catch (e) {
      addMessageToChatBox("Erreur de traitement de la réponse", "bot");
    }
  }

  // Système de thème
  function toggleTheme() {
    const root = document.documentElement;
    const currentTheme = root.getAttribute('data-theme');
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', newTheme);
    localStorage.setItem('idyie_theme', newTheme);
  }

  function addMessageToChatBoxTest(content) {
    const chatBox = document.getElementById("chat-box");
    const messageDiv = document.createElement("div");
    messageDiv.style.background = "#7FFFAB";
    messageDiv.style.color = "#111";
    messageDiv.style.padding = "10px";
    messageDiv.style.borderRadius = "5px";
    messageDiv.style.maxWidth = "70%";
    messageDiv.style.margin = "10px 0";
    messageDiv.textContent = content;
    chatBox.appendChild(messageDiv);
    chatBox.scrollTop = chatBox.scrollHeight;
  }
</script>
