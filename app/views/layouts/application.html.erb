<!DOCTYPE html>
<html>
  <head>
    <style>
      html:not([data-theme]) {
        visibility: hidden;
      }
    </style>
    <script>
      (function() {
        const savedTheme = localStorage.getItem('idyie_theme');
        if (savedTheme) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          document.documentElement.setAttribute('data-theme', 'light'); // ou ton thème par défaut
        }
      })();
    </script>


    <title>Web</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fondamento:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">


    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/vfs_fonts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  </head>

  <body>
          <%= yield %>

    <script>
      // Theme management - Global script
      // Use window object to avoid redeclaration conflicts with Turbo
      if (!window.themeManager) {
        window.themeManager = {
          initialized: false,

          setTheme: function(theme) {
            console.log('Global: Setting theme to:', theme);
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('idyie_theme', theme);
            this.updateThemeIcons(theme);
            this.updateModalSelector(theme);
          },

          getTheme: function() {
            return localStorage.getItem('idyie_theme') || 'dark';
          },

          updateThemeIcons: function(theme) {
            const darkIcon = document.getElementById('dark-theme');
            const lightIcon = document.getElementById('light-theme');

            console.log('Global: Updating icons - Dark icon found:', !!darkIcon, 'Light icon found:', !!lightIcon);

            if (darkIcon && lightIcon) {
              darkIcon.classList.remove('active');
              lightIcon.classList.remove('active');

              if (theme === 'dark') {
                darkIcon.classList.add('active');
                console.log('Global: Dark theme active');
              } else if (theme === 'light') {
                lightIcon.classList.add('active');
                console.log('Global: Light theme active');
              }
            }
          },

          updateModalSelector: function(theme) {
            const modalSelector = document.getElementById('theme');
            if (modalSelector) {
              modalSelector.value = theme;
              console.log('Global: Updated modal selector to:', theme);
            }
          },

          initTheme: function() {
            const theme = this.getTheme();
            console.log('Global: Initializing theme:', theme);

            this.setTheme(theme);
            this.setupThemeListeners();

            this.initialized = true;
          },

          setupThemeListeners: function() {
            const darkIcon = document.getElementById('dark-theme');
            const lightIcon = document.getElementById('light-theme');

            // Only setup listeners if buttons exist (login page)
            if (darkIcon && lightIcon) {
              console.log('Global: Setting up theme listeners for login page');

              if (darkIcon) {
                darkIcon.removeEventListener('click', this.darkClickHandler);
                darkIcon.removeEventListener('mousedown', this.darkClickHandler);
                darkIcon.addEventListener('click', this.darkClickHandler.bind(this));
                darkIcon.addEventListener('mousedown', this.darkClickHandler.bind(this));
              }

              if (lightIcon) {
                lightIcon.removeEventListener('click', this.lightClickHandler);
                lightIcon.removeEventListener('mousedown', this.lightClickHandler);
                lightIcon.addEventListener('click', this.lightClickHandler.bind(this));
                lightIcon.addEventListener('mousedown', this.lightClickHandler.bind(this));
              }
            } else {
              console.log('Global: No theme buttons found, skipping theme listeners setup');
            }

            this.setupModalSelector();
          },

          setupModalSelector: function() {
            const modalSelector = document.getElementById('theme');
            if (modalSelector) {
              modalSelector.removeEventListener('change', this.modalSelectorHandler);
              modalSelector.addEventListener('change', this.modalSelectorHandler.bind(this));
            }
          },

          darkClickHandler: function(e) {
            e.preventDefault();
            e.stopPropagation();
            console.log('Global: Dark theme clicked');
            this.setTheme('dark');
          },

          lightClickHandler: function(e) {
            e.preventDefault();
            e.stopPropagation();
            console.log('Global: Light theme clicked');
            this.setTheme('light');
          },

          modalSelectorHandler: function(e) {
            const newTheme = e.target.value;
            console.log('Global: Modal selector changed to:', newTheme);
            this.setTheme(newTheme);
          }
        };

        // Initialize only once when DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            console.log('Global: DOM Content Loaded - Initializing theme');
            window.themeManager.initTheme();
          });
        } else {
          console.log('Global: DOM already ready - Initializing theme immediately');
          window.themeManager.initTheme();
        }
      } else {
        // Theme manager already exists, just reinitialize if needed
        console.log('Global: Theme manager already exists, reinitializing');
        window.themeManager.initTheme();
      }
    </script>
  </body>
</html>
