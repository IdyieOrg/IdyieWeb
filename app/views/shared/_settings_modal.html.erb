<div id="settingsModal" class="modal fade" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content settings-modal-content">
      <div class="modal-header settings-modal-header">
        <h5 class="modal-title" id="settingsModalLabel">Paramètres</h5>
        <%= button_tag "", type: "button", class: "btn-close", data: { bs_dismiss: "modal" }, aria: { label: "Close" } %>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-4 settings-menu-col">
            <ul class="nav flex-column nav-pills settings-menu" id="settingsMenu" role="tablist">
              <li class="nav-item" role="presentation">
                <%= link_to 'Profil', '#profile-settings', class: 'nav-link active', id: 'profile-tab', data: { bs_toggle: 'pill' }, role: 'tab', aria_controls: 'profile-settings', aria_selected: 'true' %>
              </li>
              <li class="nav-item" role="presentation">
                <%= link_to 'Général', '#general-settings', class: 'nav-link', id: 'general-tab', data: { bs_toggle: 'pill' }, role: 'tab', aria_controls: 'general-settings', aria_selected: 'false' %>
              </li>
              <li class="nav-item" role="presentation">
                <%= link_to 'Personnalisation', '#customization-settings', class: 'nav-link', id: 'customization-tab', data: { bs_toggle: 'pill' }, role: 'tab', aria_controls: 'customization-settings', aria_selected: 'false' %>
              </li>
            </ul>
          </div>
          <div class="col-md-8">
            <div class="tab-content">
              <div class="tab-pane fade show active" id="profile-settings" role="tabpanel" aria-labelledby="profile-tab">
                <h5>Profil</h5>
                <div class="d-flex align-items-center mb-3">
                  <%= image_tag "/logo_idyie.png", id: "profileImage", class: "rounded-circle profile-img", width: 100, height: 100 %>
                  <div class="ms-3">
                    <%= label_tag :profile_pic, "Changer", class: "btn btn-outline-light btn-sm", for: "profilePicUpload" %>
                    <%= file_field_tag :profile_pic, id: "profilePicUpload", accept: "image/*", class: "d-none" %>
                  </div>
                </div>
                <div class="mb-3">
                  <%= label_tag :username, "Nom d'utilisateur", class: "form-label" %>
                  <%= text_field_tag :username, "MonPseudo", class: "form-control profile-input" %>
                </div>
                <div class="mb-3">
                  <%= label_tag :email, "Email", class: "form-label" %>
                  <%= email_field_tag :email, "exemple@email.com", class: "form-control profile-input" %>
                </div>
              </div>
              <div class="tab-pane fade" id="general-settings" role="tabpanel" aria-labelledby="general-tab">
                <h5>Général</h5>
                <div class="mb-3">
                  <%= label_tag :theme, "Thème", class: "form-label" %>
                  <%= select_tag :theme, options_for_select([["Système", "system"], ["Clair", "light"], ["Sombre", "dark"]]), class: "form-select theme-select" %>
                </div>
                <div class="mb-3">
                  <%= label_tag :language, "Langue", class: "form-label" %>
                  <%= select_tag :language, options_for_select([["Français", "fr"], ["English", "en"]]), class: "form-select language-select" %>
                </div>
                <div class="mt-4">
                  <%= button_tag "Supprimer tous les chats", type: "button", class: "btn btn-danger", id: "deleteAllChats" %>
                </div>
              </div>
              <div class="tab-pane fade" id="customization-settings" role="tabpanel" aria-labelledby="customization-tab">
                <h5>Personnalisation</h5>
                <div class="mb-3">
                  <%= label_tag :color_palette, "Palette de couleurs", class: "form-label" %>
                  <%= select_tag :color_palette, options_for_select([
                    ["Défaut", "default"],
                    ["Daltonisme - Protanopie", "protanopia"],
                    ["Daltonisme - Deutéranopie", "deuteranopia"],
                    ["Daltonisme - Tritanopie", "tritanopia"],
                    ["Contraste élevé", "high_contrast"]
                  ]), class: "form-select palette-select" %>
                </div>
                <div class="mb-3">
                  <%= label_tag :text_size, "Taille du texte", class: "form-label" %>
                  <%= range_field_tag :text_size, 16, min: 12, max: 24, step: 1, class: "form-range", id: "textSizeRange" %>
                </div>
                <div class="mb-3 p-3 border rounded text-size-preview" id="textSizePreview">
                  Aperçu du texte (taille dynamique)
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer settings-modal-footer">
        <%= button_tag "Enregistrer", type: "button", class: "btn btn-success" %>
      </div>
    </div>
  </div>
</div> 