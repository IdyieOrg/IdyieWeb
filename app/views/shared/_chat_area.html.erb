<div class="main-content">
  <div class="chat-area">
    <div id="chat-box" class="chat-box"></div>
  </div>
  <form class="prompt-input-bar" autocomplete="off">
    <button type="button" class="mic-btn" tabindex="-1">
      <i class="fas fa-microphone" id="microphone"></i>
    </button>
    <input type="text" name="search[query]" class="prompt-input" placeholder="Tapez votre requête ici" autocomplete="off" />
    <button type="submit" id="prompt" class="send-btn">Envoyer</button>
  </form>
</div> 