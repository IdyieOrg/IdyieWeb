

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
<div class="login-page">
  <div class="login-container">
    <div class="theme-selector">
      <button type="button" class="theme-btn" id="dark-theme" title="Mode sombre">
        <i class="fas fa-moon"></i>
      </button>
      <button type="button" class="theme-btn" id="light-theme" title="Mode clair">
        <i class="fas fa-sun"></i>
      </button>
    </div>

    <div class="title">
      <h1 style="font-size:175%;">Welcome to</h1>
      <h1 class="fondamento-regular title">Idyie</h1>
    </div>

    <div class="form-group">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", placeholder: "firstname.lastname@mail.com", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Password" %>
      <div class="password-container">
        <%= f.password_field :password, class: "input", style: "padding-right: 40px;", placeholder: "password", id: "password", required: true %>
        <i class="fas fa-eye-slash eye-icon" id="togglePassword"></i>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.submit "Log in", class: "custom-btn login-btn" %>
    </div>

    <div class="form-group">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('.password-container');
    const passwordField = document.getElementById('password');

    container.addEventListener('click', function(e) {
      const eyeIcon = e.target.closest('#togglePassword');
      if (!eyeIcon) return;

      e.preventDefault();

      const isPassword = passwordField.type === 'password';
      passwordField.type = isPassword ? 'text' : 'password';

      eyeIcon.classList.toggle('fa-eye-slash', !isPassword);
      eyeIcon.classList.toggle('fa-eye', isPassword);
    });
  });
</script>
