<!-- Sign Up Page -->

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="login-page">
    <div class="login-container">
      <div class="theme-selector">
        <button type="button" class="theme-btn" id="dark-theme" title="Mode sombre">
          <i class="fas fa-moon"></i>
        </button>
        <button type="button" class="theme-btn" id="light-theme" title="Mode clair">
          <i class="fas fa-sun"></i>
        </button>
      </div>

      <div class="title">
        <h1 style="font-size:175%;">Sign Up</h1>
      </div>
  
      <div class="form-group">
        <%= f.label :email %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", placeholder: "firstname.lastname@mail.com", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password" %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
        <% end %><br />
        <%= f.password_field :password, autocomplete: "new-password", class: "input", placeholder: "password", id: "password", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input", placeholder: "password", id: "password_confirmation", required: true %>
      </div>

      <div class="form-group" style="padding-top: 20px;">
        <%= f.submit "Sign up", class: "custom-btn login-btn" %>
      </div>

      <div class="back-container">
        <%= link_to new_session_path(resource_name), class:"back-link" do %>
          <i class="fas fa-arrow-left"></i>
          <span>Go back to Log In page</span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
